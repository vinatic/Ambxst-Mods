{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "vinatic.hue-bridge-controller",
  "name": "Hue Bridge Controller",
  "version": "2.0.1",
  "description": "Simple phillips hue bridge controller",
  "license": "AGPL-3.0-only",
  "author": "vinatic",
  "authorUrl": "https://github.com/vinatic",
  "homepage": "https://github.com/vinatic/Ambxst-Mods/tree/main/packages/hue-bridge-controller",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.2.5 <1.4.0",
    "testedBaseCommits": [
      "287573bf9e5f3ed4ac40f5ead8b5879b595c5577",
      "42e6b479d6cf3132d7e2b12b8dfb9fdfd6c02a78",
      "d6a3b7207bdc9591d545ee6cac785446279a5a72",
      "a392d270283d5ade9d7f75b9c47d670a64b640c4",
      "c5709276c0b25e06559bfeb62e6c2de999abdedb"
    ]
  },
  "permissions": [
    "Uses curl to send commands to hue-bridge"
  ],
  "settings": {
    "schema": "settings.json"
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/HueService.qml",
      "target": "modules/services/HueService.qml"
    },
    {
      "type": "overlay",
      "source": "payload/HueItem.qml",
      "target": "modules/widgets/dashboard/hue/HueItem.qml"
    },
    {
      "type": "overlay",
      "source": "payload/HueTab.qml",
      "target": "modules/widgets/dashboard/hue/HueTab.qml"
    },
    {
      "type": "overlay",
      "source": "payload/HueWidget.qml",
      "target": "modules/widgets/dashboard/widgets/HueWidget.qml"
    },
    {
      "type": "patch",
      "source": "patches/hue-bridge-controller.patch"
    }
  ]
}
